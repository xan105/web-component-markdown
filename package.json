{
  "name": "@xan105/markdown",
  "version": "1.4.1",
  "description": "Web-component to render markdown into html with syntax highlighting",
  "type": "module",
  "exports": "./lib/index.js",
  "browser": "./dist/markdown.min.js",
  "config": {
    "root": "./"
  },
  "files": [
    "/dist",
    "/lib"
  ],
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "lint": "eslint \"./lib/**/*.js\"",
    "bundle": "npm run-script bundle:pretty && npm run-script bundle:min && npm run-script bundle:style",
    "bundle:pretty": "esbuild \"./lib/index.js\" --bundle --legal-comments=none --platform=browser --target=esnext --format=esm --outfile=\"./dist/markdown.js\"",
    "bundle:min": "esbuild \"./lib/index.js\" --bundle --minify --legal-comments=none --platform=browser --target=esnext --format=esm --outfile=\"./dist/markdown.min.js\"",
    "bundle:style": "esbuild \"./style/index.css\" --bundle --outfile=\"./dist/style.css\"",
    "test": "start http://localhost/test && websrv"
  },
  "keywords": [
    "markdown",
    "web-component",
    "browser",
    "esbuild"
  ],
  "author": {
    "name": "Anthony Beaumont",
    "email": "dev.xan105@outlook.be",
    "url": "https://xan105.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xan105/web-component-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/xan105/web-component-markdown/issues"
  },
  "homepage": "https://github.com/xan105/web-component-markdown#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/xan105"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/xan105"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@xan105/qwebsrv": "^1.1.0",
    "@xan105/vanilla-query": "^1.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "marked-katex-extension": "^5.1.13"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-alert": "^2.1.2",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4"
  }
}
